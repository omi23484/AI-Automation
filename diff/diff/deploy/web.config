<?xml version="1.0" encoding="utf-8"?>
<!--
  NetPulse — IIS site configuration (static hosting).

  Drop this file next to netpulse.html in the site's physical folder. IIS needs
  only the "Static Content" role service; there is no ASP.NET, no application
  pool code and no database in this configuration.

  NOTE ON DATA LOCATION: this hosts the *application*, not the data. NetPulse
  stores everything in each visitor's own browser (IndexedDB). Two people opening
  this URL see two entirely separate datasets, and clearing site data erases that
  person's copy. See IIS-Deployment.md before assuming shared storage.
-->
<configuration>
  <system.webServer>

    <!-- No directory listings; the app is the default document. -->
    <directoryBrowse enabled="false" />
    <defaultDocument>
      <files>
        <clear />
        <add value="netpulse.html" />
      </files>
    </defaultDocument>

    <!-- Serve only what the app is made of. Anything else is a mistake. -->
    <staticContent>
      <clear />
      <mimeMap fileExtension=".html" mimeType="text/html; charset=utf-8" />
      <mimeMap fileExtension=".md"   mimeType="text/markdown; charset=utf-8" />
      <mimeMap fileExtension=".ico"  mimeType="image/x-icon" />
      <!-- The app is one file and changes on each release: revalidate every load
           so nobody runs a stale build after an upgrade. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpCompression>
      <dynamicTypes>
        <add mimeType="text/html" enabled="true" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/html" enabled="true" />
      </staticTypes>
    </httpCompression>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpProtocol>
      <customHeaders>
        <!-- Remove the version banner IIS adds by default. -->
        <remove name="X-Powered-By" />

        <!-- frame-ancestors is the one CSP directive a <meta> tag cannot set, so it
             is added here. Everything else in the policy already ships inside
             netpulse.html; it is deliberately NOT duplicated here, so the two can
             never drift apart. -->
        <add name="Content-Security-Policy" value="frame-ancestors 'none'" />

        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="Cross-Origin-Resource-Policy" value="same-origin" />
        <!-- The app uses none of these; deny them so a future edit cannot either. -->
        <add name="Permissions-Policy" value="geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()" />

        <!-- HSTS. Enable ONLY once HTTPS works, and see the note in the deployment
             guide about the effect on other sites sharing this hostname.
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        -->
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <!-- A 400 MB workbook is never uploaded to the server — parsing happens in
             the browser — so request bodies stay small. -->
        <requestLimits maxAllowedContentLength="1048576" />
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
        </verbs>
        <fileExtensions allowUnlisted="false">
          <add fileExtension=".html" allowed="true" />
          <add fileExtension=".ico" allowed="true" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="deploy" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Redirect plain HTTP to HTTPS. Without a secure context the browser
         withholds navigator.storage, so NetPulse cannot ask for persistent
         storage and the Admin > Storage panel goes blank (verified). Requires the
         URL Rewrite module; delete this block if it is not installed and force
         HTTPS at the load balancer or by not binding port 80 at all. -->
    <rewrite>
      <rules>
        <rule name="HTTPS only" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>

  <system.web>
    <!-- Windows Authentication: identity comes from the domain, so there is no
         password for this app to store or leak. Configure the allowed group in
         IIS Manager > Authorization Rules, or uncomment and edit below. -->
    <authentication mode="Windows" />
    <!--
    <authorization>
      <allow roles="YOURDOMAIN\NetPulse-Users" />
      <deny users="*" />
    </authorization>
    -->
    <httpRuntime enableVersionHeader="false" />
  </system.web>
</configuration>
